{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bun-sveltekit-typescript-opencode-hcnsec-id-app",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-02-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
